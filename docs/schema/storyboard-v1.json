        "left": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Left",
          "type": "string"
        },
        "right": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Right",
          "type": "string"
        }
      },
      "required": [
        "label",
        "left",
        "right"
      ],
      "title": "ComparisonCriterion",
      "type": "object"
    },
    "ComparisonSide": {
