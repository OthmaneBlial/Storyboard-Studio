          "maximum": 10,
          "minimum": 1,
          "title": "Slide Number",
          "type": "integer"
        },
        "title": {
          "maxLength": 68,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "maxLength": 220,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "bullet_points": {
          "items": {
            "$ref": "#/$defs/BulletPoint"
          },
          "maxItems": 3,
          "title": "Bullet Points",
          "type": "array"
        },
        "layout": {
          "default": "right",
          "enum": [
            "left",
            "right",
            "focus"
          ],
          "title": "Layout",
          "type": "string"
        },
        "block": {
          "default": "standard",
          "enum": [
            "standard",
            "comparison",
            "decision",
            "timeline",
            "metric",
            "process",
            "quote",
            "table"
          ],
          "title": "Block",
          "type": "string"
        },
        "content_block": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "comparison": "#/$defs/ComparisonBlock",
                  "decision": "#/$defs/DecisionBlock",
                  "metric": "#/$defs/MetricBlock",
                  "process": "#/$defs/ProcessBlock",
                  "quote": "#/$defs/QuoteBlock",
                  "standard": "#/$defs/StandardBlock",
                  "table": "#/$defs/TableBlock",
                  "timeline": "#/$defs/TimelineBlock"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/StandardBlock"
                },
                {
                  "$ref": "#/$defs/ComparisonBlock"
                },
                {
                  "$ref": "#/$defs/DecisionBlock"
                },
                {
                  "$ref": "#/$defs/TimelineBlock"
                },
                {
                  "$ref": "#/$defs/MetricBlock"
                },
                {
                  "$ref": "#/$defs/ProcessBlock"
                },
                {
                  "$ref": "#/$defs/QuoteBlock"
                },
                {
                  "$ref": "#/$defs/TableBlock"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Block"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 6,
          "title": "Sources",
          "type": "array"
        },
        "speaker_notes": {
          "default": "",
          "maxLength": 1200,
          "title": "Speaker Notes",
          "type": "string"
