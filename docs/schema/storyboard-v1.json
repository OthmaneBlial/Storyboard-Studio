          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "owner": {
          "default": "",
          "maxLength": 80,
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "label",
        "title"
