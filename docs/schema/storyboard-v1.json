          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "context"
      ],
      "title": "MetricBlock",
      "type": "object"
    },
    "PresentationPayload": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 90,
          "minLength": 1,
