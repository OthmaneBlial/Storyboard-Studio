          "type": "array"
        }
      },
      "required": [
        "sides",
        "criteria"
      ],
      "title": "ComparisonBlock",
      "type": "object"
    },
    "ComparisonCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
