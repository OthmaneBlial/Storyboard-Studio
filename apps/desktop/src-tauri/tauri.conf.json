{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storyboard Studio",
  "version": "0.3.0",
  "identifier": "io.github.othmaneblial.storyboard-studio",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run prepare-fonts",
    "beforeDevCommand": "npm run prepare-fonts"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Storyboard Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 660,
        "backgroundColor": "#171B21",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A native local-first presentation compiler",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
