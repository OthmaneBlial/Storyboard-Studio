# Optional. Without this key, Storyboard Studio creates local editable outlines.
GEMINI_API_KEY=replace-with-your-key

# Optional Gemini text model override. The default is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional experimental local OpenAI-compatible endpoint. Loopback hosts only.
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_MODEL=your-local-model
# OPENAI_COMPATIBLE_API_KEY=local-endpoint-token

# Optional provider request timeout in seconds, bounded to 1-120 (default 30).
# PROVIDER_TIMEOUT_SECONDS=30
